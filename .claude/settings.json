{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/discover.py *)",
      "Bash(python3 scripts/tracker.py *)",
      "WebSearch",
      "Bash(python3 scripts/universe.py *)",
      "Bash(python3 scripts/doctor.py)",
      "Bash(date)",
      "Edit(/data/**)",
      "mcp__playwright__*",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message"
    ],
    "deny": [
      "Edit(/config/**)",
      "Edit(/profile/**)",
      "Edit(/data/tracker.csv)",
      "Edit(/.claude/**)",
      "Bash(python3 scripts/lock_resumes.py)",
      "Bash(python3 scripts/lock_resumes.py *)",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright__browser_file_upload",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_upload.py\""
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_type|mcp__playwright__browser_fill_form",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_text.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_open_jobs.py\""
          }
        ]
      }
    ]
  }
}